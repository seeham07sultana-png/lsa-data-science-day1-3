# String Analyzer
text = "Python Data Science"

total = len(text)
spaces = 0
vowels = 0
consonants = 0
for char in text:
    if char == " ":
        spaces = spaces +1
    elif char.lower() in "aeiou":
        vowels = vowels +1
    else:
        consonants = consonants +1

print("Test:",text)
print("total char :",total)
print("spaces:",spaces)
print("vowels:",vowels)
print("consonants:",consonants)

